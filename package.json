{
  "name": "@0_0/paseo-plugin-superagent",
  "version": "0.2.0",
  "description": "Event-driven Router/Worker orchestration for Paseo: a lightweight Router per thread triages events, isolated Workers execute tickets, with IM triggers (Feishu, DingTalk, WeCom, WeChat, QQ) and a watchdog",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "agent",
    "orchestration",
    "router",
    "worker",
    "feishu",
    "dingtalk",
    "wecom",
    "wechat",
    "qq"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/lekai63/paseo-plugin-superagent",
  "bugs": {
    "url": "https://github.com/lekai63/paseo-plugin-superagent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lekai63/paseo-plugin-superagent.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "paseo-plugin.json",
    "README.md",
    "README-CN.md",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "LICENSE",
    "assets/",
    "docs/",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.1",
    "@tanstack/react-query": "^5.90.2",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.0",
    "esbuild": "0.27.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@getpaseo/client": "0.16.1",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.6-beta.1",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  }
}
